{
  "research_id": "phase11_premium_direction_predictor",
  "branch": "phase-11-premium-direction-predictor",
  "observation": {
    "underlying": "NIFTY",
    "timezone": "Asia/Kolkata",
    "time": "10:00",
    "lead_sessions": 4
  },
  "required_fields": [
    "event_date",
    "expiry_date",
    "nifty_spot_1000",
    "expiry_settlement",
    "atm_strike",
    "strike_interval",
    "ce_otm6_price",
    "ce_otm7_price",
    "ce_otm8_price",
    "pe_otm6_price",
    "pe_otm7_price",
    "pe_otm8_price"
  ],
  "preferred_optional_fields": [
    "ce_otm6_bid",
    "ce_otm6_ask",
    "ce_otm7_bid",
    "ce_otm7_ask",
    "ce_otm8_bid",
    "ce_otm8_ask",
    "pe_otm6_bid",
    "pe_otm6_ask",
    "pe_otm7_bid",
    "pe_otm7_ask",
    "pe_otm8_bid",
    "pe_otm8_ask",
    "ce_otm6_volume",
    "ce_otm7_volume",
    "ce_otm8_volume",
    "pe_otm6_volume",
    "pe_otm7_volume",
    "pe_otm8_volume",
    "ce_otm6_oi",
    "ce_otm7_oi",
    "ce_otm8_oi",
    "pe_otm6_oi",
    "pe_otm7_oi",
    "pe_otm8_oi",
    "india_vix"
  ],
  "primary_formula": {
    "call_score": "CE_OTM7 + CE_OTM8 - CE_OTM6",
    "put_score": "PE_OTM7 + PE_OTM8 - PE_OTM6",
    "spread": "call_score - put_score"
  },
  "primary_label": {
    "spread_gt_0": "bearish",
    "spread_lt_0": "bullish",
    "spread_eq_0": "neutral"
  },
  "outcome": {
    "return": "expiry_settlement / nifty_spot_1000 - 1",
    "direction_positive": "bullish",
    "direction_negative": "bearish",
    "direction_zero": "neutral"
  },
  "source_priority": [
    "NSE official",
    "BSE official where relevant",
    "reputable public historical repositories",
    "GitHub",
    "Kaggle",
    "Hugging Face via HF_TOKEN",
    "other reputable providers"
  ],
  "cache_policy": "Keep validated historical data in repository/cache artifacts; do not redownload complete history on every workflow run.",
  "provenance_required": true,
  "snapshot_protocol": {
    "option_price_field": "open",
    "spot_price_field": "open",
    "required_timestamp": "10:00:00 Asia/Kolkata",
    "fallback_in_primary_sample": "exclude event",
    "fallback_reserved_for_sensitivity": true
  },
  "outcome_protocol": {
    "expiry_value_field": "latest NIFTY 1-minute close on expiry trading date",
    "status": "provisional_settlement_proxy",
    "official_validation_required": true
  },
  "source_notes": {
    "option_dataset": "rissin/nse-options-intraday",
    "spot_dataset": "technovusin/nifty50-historical-data",
    "initial_option_intraday_start": "2024-10"
  },
  "licensing": {
    "option_dataset_license_field": "other",
    "raw_redistribution_review_required": true,
    "derived_event_data_can_be_committed": true
  }
}
